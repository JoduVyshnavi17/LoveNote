# LoveNotes backend environment configuration
# Save/copy this file as: backend/.env
# Replace every placeholder with your own current credentials.

APP_NAME=LoveNotes
ENVIRONMENT=development

# MySQL connection
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=mysql+pymysql://lovenotes_app:Joduvyshu123@localhost:3306/lovenotes

# Generate a fresh secret; do not reuse an old/shared JWT secret.
# PowerShell command: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_passsord
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=Yourpassword
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
AI_RETRY_ATTEMPTS=1
AI_RETRY_BASE_SECONDS=0.3
AI_MAX_CONCURRENT_REQUESTS=2

# Optional OpenAI fallback (leave blank if not using OpenAI)
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# OCR configuration
# tesseract is local OCR; use gemini_vision only if you have configured AI vision access.
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Application settings
ADMIN_EMAIL=joduvyshnavi@gmail.com
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=../storage/uploads
MAX_UPLOAD_MB=20480
